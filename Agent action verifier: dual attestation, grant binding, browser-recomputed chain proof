const A = {}; DATA.actions.forEach(r => A[r.action_key] = r);
const SAMPLES = [];
[["certified - honest payment", r => r.kind=="honest" && r.decision=="PAYMENT_CERTIFIED"],
 ["blocked - log forging (expired)", r => r.kind=="log_forging"],
 ["blocked - action replay", r => r.kind=="action_replay"],
 ["blocked - authority laundering", r => r.kind=="authority_laundering"],
 ["blocked - repudiation", r => r.kind=="repudiation"],
 ["blocked - sybil principal", r => r.kind=="sybil_principal"]].forEach(([label,f])=>{
  const r = DATA.actions.find(f); if(r) SAMPLES.push([label, r.action_key]);});
const chips = document.getElementById('chips');
SAMPLES.forEach(([label,k])=>{const s=document.createElement('span');s.className='chip';s.textContent=label;s.onclick=()=>{document.getElementById('q').value=k;verify();};chips.appendChild(s);});
function canon(x){
  if(x===null||typeof x!=='object') return JSON.stringify(x);
  if(Array.isArray(x)) return '['+x.map(canon).join(',')+']';
  return '{'+Object.keys(x).sort().map(k=>JSON.stringify(k)+':'+canon(x[k])).join(',')+'}';}
async function sha256hex(s){const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s));
  return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('');}
const rs = n => 'Rs ' + Math.round(n).toLocaleString('en-IN');
async function verify(){
  const k = document.getElementById('q').value.trim();
  const r = A[k]; const out = document.getElementById('out');
  if(!r){out.style.display='block';
    document.getElementById('rec').innerHTML='<div class="k">Action ID</div><div class="mono">'+k.replace(/[<>&]/g,'')+'</div><div class="k">Outcome</div><div><span class="badge bad">NOT IN REGISTRY</span></div>';
    document.getElementById('rulescard').style.display='none';
    document.getElementById('proof').innerHTML='<p class="note">No record exists under this ID. On the rail, an action that was never attested by both sides simply does not exist - there is nothing to dispute.</p>';
    return;}
  out.style.display='block';
  const badge = r.decision=='PAYMENT_CERTIFIED' ? '<span class="badge ok">CERTIFIED</span>'
    : r.decision=='EXPIRED_NO_COUNTERSIGN' ? '<span class="badge warn">EXPIRED - NEVER SETTLED</span>'
    : '<span class="badge bad">REJECTED</span>';
  const kindNote = r.kind=='honest' ? '' : ' &middot; attempted fraud class: <b>'+r.kind.replace(/_/g,' ')+'</b>';
  document.getElementById('rec').innerHTML =
    row('Action ID', '<span class="mono">'+r.action_key+'</span>') +
    row('Actor (agent)', r.actor_name + ' <span class="mono">'+r.actor+'</span>') +
    row('Account', '<span class="mono">'+r.account+'</span>') +
    row('Action', r.verb.replace(/_/g,' ') + ' &middot; ' + rs(r.value)) +
    row('Authority at log time', 'grant ceiling ' + rs(r.grant_max) + (r.value>r.grant_max ? ' <span class="badge bad">EXCEEDED</span>' : ' <span class="badge ok">WITHIN SCOPE</span>')) +
    row('Filed / settled', 'cycle ' + r.filed_cycle + (r.settled_cycle ? ' / cycle ' + r.settled_cycle : ' / never')) +
    row('Outcome', badge + kindNote);
  function row(k,v){return '<div class="k">'+k+'</div><div>'+v+'</div>';}
  const rc = document.getElementById('rulescard');
  if(r.rules.length){
    rc.style.display='block';
    document.getElementById('rules').innerHTML = '<tr><th>Rule</th><th>Result</th></tr>' + r.rules.map(([n,ok])=>
      '<tr><td>'+n.replace(/_/g,' ')+'</td><td class="'+(ok?'pass':'fail')+'">'+(ok?'PASS':'FAIL')+'</td></tr>').join('');
  } else {
    rc.style.display='block';
    document.getElementById('rules').innerHTML = '<tr><td class="note">No decision was ever made: the counterparty attestation never arrived, so the action was held and then expired at the deadline. No money moved. This is how a forged log dies - held, never denied, never paid.</td></tr>';
  }
  const pr = document.getElementById('proof');
  if(r.certificate){
    const payload = {product:'agent_audit', subject_id:r.actor, cycle:r.action_key, decision:r.decision, rules:r.rules, source_manifest:r.manifest};
    const recomputed = await sha256hex(canon(payload));
    const match = recomputed === r.certificate;
    pr.innerHTML = '<div class="kv">' +
      row('Stored certificate', '<span class="mono">'+r.certificate+'</span>') +
      row('Recomputed in your browser', '<span class="mono">'+recomputed+'</span>') +
      row('Proof', match ? '<span class="badge ok">VALID - the record recomputes exactly</span>' : '<span class="badge bad">MISMATCH</span>') + '</div>' +
      '<p class="note">The certificate is sha256 over the canonical record (product, actor, action, decision, every rule result, the evidence manifest). Change one character anywhere and the hash breaks. Verification needs no login, no API key, and no trust in us.</p>';
  } else {
    pr.innerHTML = '<p class="note">No certificate exists for this action because it never settled. The absence of a record is the verdict: the counterparty never confirmed it, the chain never absorbed it, and it expired. A forged log cannot produce a certificate because producing one requires the other side.</p>';
  }
}
document.getElementById('q').addEventListener('keydown', e=>{if(e.key==='Enter')verify();});
